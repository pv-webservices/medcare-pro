// MEDCARE PRO — data model (v2).
//
// Source of truth: docs/PRD.md §7. ONE shared MySQL database for all tenants.
// Isolation is by column, not by deployment: every account-scoped table carries
// `tenant_id`, every clinic-scoped table carries `clinic_id`, and every query is
// filtered in the application layer from the authenticated session.
// This is a deliberate reversal of the v1 "one database per clinic" model.
//
// Naming convention: PascalCase models / camelCase fields (TypeScript side),
// with @map / @@map preserving the exact snake_case table and column names
// from PRD §7 in the database.
//
// PRD §7 calls the top-level tenant table `accounts`. It is modelled here as
// `Tenant` / `tenants` to avoid colliding with Auth.js's OAuth adapter model,
// which is also named `Account` and whose name is not ours to change.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy & identity — PRD §7 `accounts` / `users`, FR-1.x
//
// The Auth.js `Account` and `Session` adapter models are deliberately absent.
// This app is Credentials-only with the JWT session strategy (see
// src/lib/auth.config.ts), so neither table would ever be written to.
// `VerificationToken` is kept, but repurposed for our own FR-1.2 email
// verification flow rather than Auth.js's built-in magic-link flow.
// ---------------------------------------------------------------------------

/// The top-level tenant. One signup = one Tenant, which can own many Clinics.
/// Holds no credentials of its own — see the note on User.passwordHash.
model Tenant {
  id              String    @id @default(cuid())
  businessName    String    @map("business_name")
  /// Contact address collected at signup, and the address the FR-1.2
  /// verification link is sent to.
  email           String    @unique
  /// FR-1.2 / PRD §9 — login is blocked for every User under this Tenant until
  /// this is set. Verification is a property of the business, not of each
  /// individual login, so it lives here and not on User.
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  // --- Stage 1: platform lifecycle (Owner-controlled) ---------------------
  /// URL-safe identifier for this organisation. Used for the cosmetic half of
  /// an invitation link (/invite/<slug>/<token>) and nothing else — the slug is
  /// NEVER an authorisation input. See src/lib/tenantSlug.ts.
  ///
  /// NOT NULL since Stage 3 (migration 20260822120000_stage3_slug_required).
  /// The Stage 1 backfill generated one for every existing tenant and the
  /// constrain migration added the UNIQUE index; the column stayed nullable
  /// only until signup allocated one itself, which it now does inside the same
  /// transaction that creates the tenant.
  slug       String
  /// Owner-controlled approval lifecycle. A tenant is unusable until ACTIVE.
  /// Only src/lib/platform/* may write this — see the note on
  /// User.accountStatus about the two statuses never being merged.
  status     TenantStatus @default(PENDING)
  /// True for the single reserved row that exists solely so Platform Owner
  /// users can satisfy the non-null users.tenant_id foreign key. It is NOT a
  /// customer: every customer-facing query must filter isPlatform = false.
  /// Compose src/lib/platformTenant.ts's CUSTOMER_TENANT_WHERE rather than
  /// spelling the filter out by hand.
  isPlatform Boolean      @default(false) @map("is_platform")
  /// The plan whose PlanFeature rows form this tenant's baseline entitlement.
  /// Restrict, not SetNull: retiring a plan that tenants still sit on would
  /// silently strip every feature they are paying for. Retire via Plan.isActive.
  planId     String?      @map("plan_id")

  /// Registration details collected at signup (FR-1.1 collects only
  /// businessName + email today; these are the Stage 3 additions).
  city                String?
  phone               String?
  address             String?   @db.Text
  /// Optional, and INTENTIONALLY different from 'email': 'email' is the
  /// organisation's identity — unique, the login resolution key, and the
  /// address FR-1.2 verification is sent to. This one is a display/notification
  /// address a business may want to differ (e.g. billing@). It is never used
  /// for identity, login, or verification.
  primaryContactEmail String?   @map("primary_contact_email")
  /// Stage 3 requires an explicit terms/privacy consent at registration.
  termsAcceptedAt     DateTime? @map("terms_accepted_at")

  /// Approval / rejection / suspension actors are denormalised pointers for
  /// display. The authoritative, append-only record of who did what is
  /// AuditLog — which is why these are SetNull while AuditLog is Restrict.
  approvedById     String?   @map("approved_by_id")
  approvedAt       DateTime? @map("approved_at")
  rejectedById     String?   @map("rejected_by_id")
  rejectedAt       DateTime? @map("rejected_at")
  rejectionReason  String?   @map("rejection_reason") @db.Text
  suspendedById    String?   @map("suspended_by_id")
  suspendedAt      DateTime? @map("suspended_at")
  suspensionReason String?   @map("suspension_reason") @db.Text

  /// NOT NULL here because this schema is the FINAL state. @updatedAt emits a
  /// NOT NULL column with no default, which MySQL cannot add to a table that
  /// already holds rows — so the expand migration adds it nullable, the backfill
  /// sets it to created_at, and the constrain migration makes it NOT NULL.
  updatedAt                DateTime                  @updatedAt @map("updated_at")
  users                    User[]
  roles                    Role[]
  clinics                  Clinic[]
  patients                 Patient[]
  notifications            Notification[]
  whatsappTemplates        WhatsappTemplate[]
  mediaAssets              MediaAsset[]
  whatsappTemplateMedia    WhatsappTemplateMedia[]
  whatsappProviderAccounts WhatsappProviderAccount[]
  whatsappDevices          WhatsappDevice[]
  whatsappSettings         TenantWhatsappSettings?
  clinicWhatsappSettings   ClinicWhatsappSettings[]
  plan                     Plan?                     @relation(fields: [planId], references: [id], onDelete: Restrict)
  approvedBy               User?                     @relation("TenantApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  rejectedBy               User?                     @relation("TenantRejectedBy", fields: [rejectedById], references: [id], onDelete: SetNull)
  suspendedBy              User?                     @relation("TenantSuspendedBy", fields: [suspendedById], references: [id], onDelete: SetNull)
  featureOverrides         TenantFeatureOverride[]
  invitations              Invitation[]
  sessions                 AppSession[]
  auditLogs                AuditLog[]
  tasks                    Task[]
  dashboardLayouts         DashboardLayout[]
  telephonyBookingRequests TelephonyBookingRequest[]

  // --- AP-1 relations (back-relations only; no column on this table) -------
  appointments     Appointment[]
  appointmentTypes AppointmentType[]

  /// Enforced from the constrain migration onward, once the backfill has
  /// generated and validated a slug for every existing row.
  @@unique([slug])
  @@index([status])
  @@index([isPlatform])
  @@index([planId])
  @@index([approvedById])
  @@index([rejectedById])
  @@index([suspendedById])
  @@map("tenants")
}

/// A login within a Tenant. Signup creates exactly one of these (the owner);
/// further users are invited by an Owner/Admin.
model User {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  name         String?
  email        String   @unique
  /// The only password hash in the schema. PRD §7 also lists one on `accounts`,
  /// but a Tenant is an organisation, not something that logs in — credentials
  /// live solely on User and login always resolves via User.email.
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // --- Stage 1: identity, status and platform role ------------------------
  phone           String?
  /// Verification of THIS individual's address, distinct from
  /// Tenant.emailVerifiedAt which verifies the organisation's address.
  ///   - the first Tenant Admin needs both;
  ///   - an invited team member needs only their own.
  /// Backfilled from the owning tenant for pre-Stage-1 users, as a documented
  /// grandfathering decision. A newly invited member is NEVER treated as
  /// verified without their own confirmation.
  emailVerifiedAt DateTime? @map("email_verified_at")

  /// PLATFORM-controlled account status. Written ONLY by src/lib/platform/*.
  /// A Tenant Admin must never be able to change this.
  accountStatus    UserAccountStatus @default(PENDING) @map("account_status")
  /// TENANT-controlled access status, managed by the Tenant Admin.
  /// Platform Owner code must never silently clear it.
  ///
  /// The two are deliberately NOT merged. Access requires BOTH to be ACTIVE
  /// (src/lib/accessStatus.ts), so a user the Owner suspended cannot regain
  /// access just because a Tenant Admin flips membershipStatus back to ACTIVE,
  /// and vice versa. Merging them would let each side undo the other.
  membershipStatus MembershipStatus  @default(PENDING) @map("membership_status")

  /// Null = an ordinary customer user, which is almost everyone. Never
  /// settable through any customer-facing API; set only by the guarded
  /// create-owner provisioning command (Stage 2).
  platformRole PlatformRole? @map("platform_role")
  lastLoginAt  DateTime?     @map("last_login_at")

  /// Denormalised display pointers; AuditLog holds the authoritative trail.
  approvedById     String?   @map("approved_by_id")
  approvedAt       DateTime? @map("approved_at")
  rejectedById     String?   @map("rejected_by_id")
  rejectedAt       DateTime? @map("rejected_at")
  rejectionReason  String?   @map("rejection_reason") @db.Text
  suspendedById    String?   @map("suspended_by_id")
  suspendedAt      DateTime? @map("suspended_at")
  suspensionReason String?   @map("suspension_reason") @db.Text
  removedAt        DateTime? @map("removed_at")

  /// Added nullable, backfilled, then constrained — see the note on
  /// Tenant.updatedAt for the three-step path.
  updatedAt            DateTime              @updatedAt @map("updated_at")
  userRoles            UserRole[]
  dashboardLayouts     DashboardLayout[]
  registrationsCreated Registration[]        @relation("RegistrationCreatedBy")
  registrationEdits    RegistrationEditLog[]
  mediaAssetsUploaded  MediaAsset[]          @relation("MediaAssetUploadedBy")

  // --- Stage 1 relations ---------------------------------------------------
  approvedBy  User? @relation("UserApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  rejectedBy  User? @relation("UserRejectedBy", fields: [rejectedById], references: [id], onDelete: SetNull)
  suspendedBy User? @relation("UserSuspendedBy", fields: [suspendedById], references: [id], onDelete: SetNull)

  usersApproved  User[] @relation("UserApprovedBy")
  usersRejected  User[] @relation("UserRejectedBy")
  usersSuspended User[] @relation("UserSuspendedBy")

  tenantsApproved  Tenant[] @relation("TenantApprovedBy")
  tenantsRejected  Tenant[] @relation("TenantRejectedBy")
  tenantsSuspended Tenant[] @relation("TenantSuspendedBy")

  sessions        AppSession[] @relation("SessionUser")
  sessionsRevoked AppSession[] @relation("SessionRevokedBy")
  loginCodes      LoginCode[]

  invitationsSent     Invitation[] @relation("InvitationInvitedBy")
  invitationsRevoked  Invitation[] @relation("InvitationRevokedBy")
  invitationsAccepted Invitation[] @relation("InvitationAcceptedBy")

  rolesAssigned          UserRole[]                @relation("UserRoleAssignedBy")
  featureFlagsChanged    Feature[]                 @relation("FeatureGlobalChangedBy")
  tenantOverridesChanged TenantFeatureOverride[]   @relation("TenantOverrideChangedBy")
  auditLogs              AuditLog[]
  telephonyTestCalls     ClinicTelephonyTestCall[] @relation("ClinicTelephonyTestCallRequester")

  // --- AP-1 relations (back-relations only; no column on this table) -------
  /// Restrict on the owning side, matching Registration.creator: the person who
  /// booked a slot is part of the record, not a detachable pointer.
  appointmentsBooked    Appointment[] @relation("AppointmentBookedBy")
  /// SetNull on the owning side — denormalised display pointers, exactly like
  /// the approvedBy/suspendedBy pairs above. AuditLog holds the real trail.
  appointmentsCheckedIn Appointment[] @relation("AppointmentCheckedInBy")
  appointmentsCancelled Appointment[] @relation("AppointmentCancelledBy")

  tasksCreated   Task[] @relation("TaskCreatedBy")
  tasksAssigned  Task[] @relation("TaskAssignedTo")
  tasksCompleted Task[] @relation("TaskCompletedBy")

  @@index([tenantId])
  @@index([accountStatus])
  @@index([membershipStatus])
  @@index([platformRole])
  @@index([approvedById])
  @@index([rejectedById])
  @@index([suspendedById])
  @@map("users")
}

/// FR-1.2 email verification tokens. Retained from the Auth.js adapter schema
/// (the shape is a good fit) but written and consumed by our own
/// api/auth/verify-email route, not by Auth.js.
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  /// Which flow issued this token: "TENANT_EMAIL" verifies the organisation's
  /// address (Tenant.emailVerifiedAt), "USER_EMAIL" verifies one individual
  /// (User.emailVerifiedAt). At signup the two addresses are identical, so
  /// without this discriminator a token minted for one flow could be redeemed
  /// by the other. Consumption must require the expected purpose (Stage 3).
  ///
  /// A String rather than an enum: the column default backfills every existing
  /// row correctly, and the accepted values are pinned in TypeScript by
  /// VERIFICATION_PURPOSES in src/lib/verificationPurpose.ts (Stage 3).
  purpose    String   @default("TENANT_EMAIL")

  @@unique([identifier, token])
  /// A plain index, NOT a unique: the existing @unique(token) and
  /// @@unique([identifier, token]) above are preserved exactly, and adding
  /// uniqueness here would forbid a tenant and its owner — who share an
  /// address — from holding one outstanding token each.
  @@index([identifier, purpose])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// RBAC — PRD §7 `roles` / `user_roles`, FR-8.1 / FR-8.2
// ---------------------------------------------------------------------------

/// Custom and extensible per tenant. Owner/Admin/Staff are seeded defaults
/// (prisma/seed.ts), not a hardcoded enum — PRD §4.
model Role {
  id          String @id @default(cuid())
  tenantId    String @map("tenant_id")
  name        String
  /// Array of permission strings, e.g. ["registration:edit", "doctor:create"].
  /// Checked server-side by lib/rbac.ts on every mutating request.
  permissions Json

  // --- Stage 1: role metadata ----------------------------------------------
  /// Stable machine identifier for a seeded role, so code never has to match a
  /// display name a tenant is free to rename. NULL for custom roles.
  ///
  /// It is metadata for migration and seeding ONLY. Authorisation is decided by
  /// the permissions array, never by this key and never by name — the Clinic
  /// Admin check in Stage 6/7 is a permission check, not a name comparison.
  key         String?
  description String? @db.Text
  /// True for the seeded set. Reserved for a future "cannot be deleted" rule;
  /// nothing enforces it in Stage 1.
  isSystem    Boolean @default(false) @map("is_system")

  /// Added nullable, backfilled from the owning tenant's created_at (an
  /// approximation — the true creation time was never recorded), then
  /// constrained to NOT NULL.
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userRoles        UserRole[]
  featureAccess    RoleFeatureAccess[]
  invitations      Invitation[]
  dashboardLayouts DashboardLayout[]

  /// Role names are unique within a tenant, not globally.
  @@unique([tenantId, name])
  /// Added by the constrain migration. MySQL treats NULLs as distinct, so any
  /// number of custom roles (key = NULL) coexist under one tenant — which is
  /// the wanted behaviour here, unlike the user_roles case noted below.
  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("roles")
}

/// Assignment of a Role to a User, optionally narrowed to a single Clinic.
/// A null `clinic_id` means the assignment is tenant-wide. A user may hold
/// different roles in different clinics under the same tenant.
model UserRole {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  roleId       String   @map("role_id")
  /// Stage 1, additive. NULL on every pre-existing row: the original actor was
  /// never recorded and is not invented here.
  assignedById String?  @map("assigned_by_id")
  /// Stage 1, additive. Backfilled to the owning user's created_at, which is an
  /// approximation, not the true assignment time.
  createdAt    DateTime @default(now()) @map("created_at")
  clinicId     String?  @map("clinic_id")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  clinic Clinic? @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  assignedBy User? @relation("UserRoleAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([userId, roleId, clinicId])
  @@index([userId])
  @@index([roleId])
  @@index([clinicId])
  /// KNOWN QUIRK, deliberately left alone in Stage 1: MySQL treats NULLs as
  /// distinct, so the unique above does NOT prevent two identical tenant-wide
  /// rows. lib/roles.ts checks for that explicitly before inserting. Fixing it
  /// at the database level would need a sentinel value or a generated column —
  /// migration risk for no functional gain.
  @@index([assignedById])
  @@map("user_roles")
}

/// A normalized presentation preference. Exactly one of userId / roleId is set:
/// personal overrides and role defaults deliberately share no row or scope.
model DashboardLayout {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  userId    String?  @map("user_id")
  roleId    String?  @map("role_id")
  layout    Json
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role?  @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@unique([tenantId, roleId])
  @@index([tenantId])
  @@index([userId])
  @@index([roleId])
  @@map("dashboard_layouts")
}

// ---------------------------------------------------------------------------
// Clinics — PRD §7 `clinics`, FR-2.x / FR-8.3 / FR-8.4
// ---------------------------------------------------------------------------

model Clinic {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  name       String
  address    String?  @db.Text
  city       String?
  /// FR-8.3 / FR-8.4 — per-clinic branding overrides.
  logoUrl    String?  @map("logo_url") @db.LongText
  themeColor String?  @map("theme_color") @db.VarChar(9)
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  telephonyConfig ClinicTelephonyConfig?
  businessHours   ClinicBusinessHours[]
  ivrProfile      ClinicIvrProfile?

  doctors               Doctor[]
  patients              Patient[]
  registrations         Registration[]
  notifications         Notification[]
  whatsappMessages      WhatsappMessage[]
  mediaAssets           MediaAsset[]
  whatsappTemplateMedia WhatsappTemplateMedia[]
  whatsappSettings      ClinicWhatsappSettings?
  userRoles             UserRole[]
  invitations           Invitation[]

  // --- AP-1 relations (back-relations only; no column on this table) -------
  appointments             Appointment[]
  appointmentTypes         AppointmentType[]
  telephonyBookingRequests TelephonyBookingRequest[]
  telephonyCalls           ClinicTelephonyCall[]
  telephonyTestCalls       ClinicTelephonyTestCall[]
  tasks                    Task[]

  @@unique([id, tenantId])
  @@index([tenantId])
  @@map("clinics")
}

enum ClinicTelephonyRoutingMode {
  AUTO
  OPEN
  AFTER_HOURS
}

enum ClinicBusinessWeekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum ClinicIvrMenuAction {
  TOMORROW_SLOTS
  APPOINTMENT_BOOKING
  URGENT_ASSISTANCE
  CLINIC_INFORMATION
}

enum ClinicTelephonyTestCallStatus {
  REQUESTED
  RINGING
  ANSWERED
  COMPLETED
  FAILED
}

enum ClinicTelephonyTestCallFailureCategory {
  NO_ANSWER
  BUSY
  PROVIDER_ERROR
  UNKNOWN
}

enum ClinicTelephonyCallStatus {
  ACTIVE
  COMPLETED
}

enum ClinicTelephonyCallInitialRoute {
  RECEPTION
  IVR
}

enum ClinicTelephonyCallMenuSource {
  DEFAULT
  CUSTOM
}

enum ClinicTelephonyCallEventType {
  CALL_RECEIVED
  ROUTED_TO_RECEPTION
  ROUTED_TO_IVR
  MAIN_MENU_TOMORROW_SLOTS
  MAIN_MENU_APPOINTMENT_BOOKING
  MAIN_MENU_URGENT_ASSISTANCE
  MAIN_MENU_CLINIC_INFORMATION
  MAIN_MENU_REPEAT
  MAIN_MENU_INVALID_INPUT
  MENU_REVISION_REFRESHED
  APPOINTMENTS_UNAVAILABLE
  RECEPTION_CONNECTED
  RECEPTION_FAILED
  RECEPTION_FALLBACK_TO_IVR
  URGENT_TRANSFER_CONNECTED
  URGENT_TRANSFER_FAILED
  URGENT_TRANSFER_UNAVAILABLE
  BOOKING_FOLLOW_UP_CREATED
  CALL_COMPLETED
}

/// Optional per-clinic voice routing configuration. Provider credentials stay
/// deployment-level; the destination number is the only inbound routing key.
model ClinicTelephonyConfig {
  id                   String                     @id @default(cuid())
  clinicId             String                     @unique @map("clinic_id")
  plivoNumber          String?                    @unique @map("plivo_number") @db.VarChar(16)
  publicPhoneNumber    String?                    @map("public_phone_number") @db.VarChar(16)
  receptionPhoneNumber String?                    @map("reception_phone_number") @db.VarChar(16)
  urgentPhoneNumber    String?                    @map("urgent_phone_number") @db.VarChar(16)
  timezone             String                     @default("Asia/Kolkata") @db.VarChar(64)
  routingMode          ClinicTelephonyRoutingMode @default(AFTER_HOURS) @map("routing_mode")
  enabled              Boolean                    @default(false)
  createdAt            DateTime                   @default(now()) @map("created_at")
  updatedAt            DateTime                   @updatedAt @map("updated_at")

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@map("clinic_telephony_configs")
}

/// One continuous clinic-local wall-clock interval per regular weekday.
/// Special/holiday closures use ClinicTelephonyConfig.routingMode in V1.
model ClinicBusinessHours {
  id        String                @id @default(cuid())
  clinicId  String                @map("clinic_id")
  dayOfWeek ClinicBusinessWeekday @map("day_of_week")
  isClosed  Boolean               @default(true) @map("is_closed")
  openTime  String?               @map("open_time") @db.VarChar(5)
  closeTime String?               @map("close_time") @db.VarChar(5)
  createdAt DateTime              @default(now()) @map("created_at")
  updatedAt DateTime              @updatedAt @map("updated_at")

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, dayOfWeek], map: "clinic_business_hours_clinic_day_key")
  @@map("clinic_business_hours")
}

/// Optional dormant IVR configuration for a future runtime adapter. Phase 2A
/// management never changes the deterministic production menu.
model ClinicIvrProfile {
  id               String   @id @default(cuid())
  clinicId         String   @unique @map("clinic_id")
  greetingTemplate String   @map("greeting_template") @db.VarChar(500)
  language         String   @db.VarChar(16)
  voice            String   @db.VarChar(16)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  clinic Clinic              @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  items  ClinicIvrMenuItem[]

  @@map("clinic_ivr_profiles")
}

model ClinicIvrMenuItem {
  id        String              @id @default(cuid())
  profileId String              @map("profile_id")
  digit     Int
  label     String              @db.VarChar(80)
  action    ClinicIvrMenuAction
  position  Int
  enabled   Boolean             @default(true)
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")

  profile ClinicIvrProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, digit])
  @@unique([profileId, position])
  @@unique([profileId, action])
  @@map("clinic_ivr_menu_items")
}

/// One tightly bounded outbound IVR verification attempt. The full QA
/// destination, clinic provider number, credentials, callback bodies and DTMF
/// history are deliberately never stored here.
model ClinicTelephonyTestCall {
  id                  String                                  @id @default(cuid())
  clinicId            String                                  @map("clinic_id")
  requestedByUserId   String                                  @map("requested_by_user_id")
  status              ClinicTelephonyTestCallStatus           @default(REQUESTED)
  providerRequestUuid String?                                 @map("provider_request_uuid") @db.VarChar(128)
  providerCallUuid    String?                                 @map("provider_call_uuid") @db.VarChar(128)
  destinationLast4    String?                                 @map("destination_last_4") @db.Char(4)
  /// Equals clinicId only while active. MySQL permits many NULL values under
  /// a UNIQUE key, so this is the database backstop for one active call/clinic.
  activeClinicId      String?                                 @unique(map: "clinic_test_calls_active_clinic_key") @map("active_clinic_id")
  expiresAt           DateTime                                @map("expires_at")
  answeredAt          DateTime?                               @map("answered_at")
  completedAt         DateTime?                               @map("completed_at")
  failureCategory     ClinicTelephonyTestCallFailureCategory? @map("failure_category")
  createdAt           DateTime                                @default(now()) @map("created_at")
  updatedAt           DateTime                                @updatedAt @map("updated_at")

  clinic      Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  requestedBy User   @relation("ClinicTelephonyTestCallRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)

  @@index([clinicId, createdAt], map: "clinic_test_calls_clinic_created_idx")
  @@index([requestedByUserId, createdAt], map: "clinic_test_calls_requester_created_idx")
  @@index([status, expiresAt], map: "clinic_test_calls_status_expiry_idx")
  @@map("clinic_telephony_test_calls")
}

/// Privacy-bounded operational record for one real inbound call. Provider
/// correlation remains server-only; no complete telephone number, raw input,
/// patient data, recording, transcript, or provider payload is stored here.
model ClinicTelephonyCall {
  id                 String                           @id @default(cuid())
  clinicId           String                           @map("clinic_id")
  providerCallUuid   String                           @unique(map: "clinic_calls_provider_uuid_key") @map("provider_call_uuid") @db.VarChar(128)
  callerLast4        String?                          @map("caller_last_4") @db.Char(4)
  status             ClinicTelephonyCallStatus        @default(ACTIVE)
  initialRoute       ClinicTelephonyCallInitialRoute? @map("initial_route")
  routingModeAtStart ClinicTelephonyRoutingMode       @map("routing_mode_at_start")
  phoneMenuSource    ClinicTelephonyCallMenuSource?   @map("phone_menu_source")
  startedAt          DateTime                         @default(now()) @map("started_at")
  endedAt            DateTime?                        @map("ended_at")
  durationSeconds    Int?                             @map("duration_seconds")
  lastActivityAt     DateTime                         @default(now()) @map("last_activity_at")
  createdAt          DateTime                         @default(now()) @map("created_at")
  updatedAt          DateTime                         @updatedAt @map("updated_at")

  clinic Clinic                     @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  events ClinicTelephonyCallEvent[]

  @@index([clinicId, startedAt], map: "clinic_calls_clinic_started_idx")
  @@index([startedAt], map: "clinic_calls_started_idx")
  @@map("clinic_telephony_calls")
}

/// First occurrence of a safe semantic production-call event. The compound
/// uniqueness is the provider-retry idempotency boundary.
model ClinicTelephonyCallEvent {
  id         String                       @id @default(cuid())
  callId     String                       @map("call_id")
  eventType  ClinicTelephonyCallEventType @map("event_type")
  occurredAt DateTime                     @default(now()) @map("occurred_at")

  call ClinicTelephonyCall @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@unique([callId, eventType], map: "clinic_call_events_call_type_key")
  @@index([callId, occurredAt], map: "clinic_call_events_call_occurred_idx")
  @@map("clinic_telephony_call_events")
}

enum TelephonyBookingRequestReason {
  NO_PATIENT_MATCH
  AMBIGUOUS_PATIENT_MATCH
  USER_REQUESTED
}

enum TelephonyBookingRequestStatus {
  PENDING
  RESOLVED
  CANCELLED
}

/// A staff follow-up request created when deterministic caller-number matching
/// cannot safely continue automated booking. It never reserves a slot and
/// deliberately stores no patient id, candidate names, or match count.
model TelephonyBookingRequest {
  id             String                        @id @default(cuid())
  tenantId       String                        @map("tenant_id")
  clinicId       String                        @map("clinic_id")
  provider       String                        @db.VarChar(32)
  providerCallId String                        @map("provider_call_id") @db.VarChar(128)
  callerNumber   String?                       @map("caller_number") @db.VarChar(16)
  reason         TelephonyBookingRequestReason
  status         TelephonyBookingRequestStatus @default(PENDING)
  createdAt      DateTime                      @default(now()) @map("created_at")
  updatedAt      DateTime                      @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Restrict)

  @@unique([clinicId, provider, providerCallId], map: "telephony_booking_requests_clinic_provider_call_id_key")
  @@index([tenantId, clinicId, status])
  @@index([createdAt])
  @@map("telephony_booking_requests")
}

// ---------------------------------------------------------------------------
// Doctors — PRD §7 `doctors` / `doctor_availability` / `doctor_leave`, FR-4.x
// ---------------------------------------------------------------------------

model Doctor {
  id         String  @id @default(cuid())
  clinicId   String  @map("clinic_id")
  name       String
  department String
  /// Free-text rather than an enum: the PRD does not fix the accepted values,
  /// and locking them here would require a migration to add one.
  gender     String?
  age        Int?
  phone      String?

  createdAt DateTime @default(now()) @map("created_at")

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  availability  DoctorAvailability[]
  leave         DoctorLeave[]
  registrations Registration[]

  // --- AP-1 relations (back-relations only; no column on this table) -------
  /// Restrict on the owning side: an appointment is history once booked.
  appointments  Appointment[]
  /// Cascade on the owning side — these rows carry no data, only a lock.
  scheduleLocks DoctorScheduleLock[]

  /// FR-4.1 counts doctors per clinic; the registration form filters by department.
  @@index([clinicId])
  @@index([department])
  @@map("doctors")
}

/// FR-4.3 — calendar-based availability: a specific date plus a time range.
model DoctorAvailability {
  id        String   @id @default(cuid())
  doctorId  String   @map("doctor_id")
  date      DateTime @db.Date
  /// 24h "HH:mm" clock time. Stored as a string rather than DateTime so a slot
  /// carries no spurious date/timezone component.
  startTime String   @map("start_time") @db.VarChar(5)
  endTime   String   @map("end_time") @db.VarChar(5)

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId])
  @@index([date])
  @@map("doctor_availability")
}

/// FR-4.4 — optional leave, marks the doctor unavailable across a date range.
model DoctorLeave {
  id        String   @id @default(cuid())
  doctorId  String   @map("doctor_id")
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  reason    String?  @db.Text

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId])
  @@map("doctor_leave")
}

// ---------------------------------------------------------------------------
// Patients & registrations — PRD §7 `patients` / `registrations`, FR-3.x
//
// A Patient is the person; a Registration is one visit (and one revenue line).
// One patient has many registrations.
// ---------------------------------------------------------------------------

model Patient {
  id           String   @id @default(cuid())
  /// Denormalised from `clinic.tenant_id` purely so the tenant-wide uniqueness
  /// of `patient_code` can be enforced by the database (see @@unique below)
  /// rather than only by application convention. Keep it in step with the
  /// owning clinic's tenant on every write.
  tenantId     String   @map("tenant_id")
  clinicId     String   @map("clinic_id")
  /// FR-3.1 format `PT-YYYY-####`, generated server-side, sequential, and
  /// unique tenant-wide (not per clinic) per PRD §10. Generated in exactly one
  /// place: lib/generatePatientCode.ts.
  patientCode  String   @map("patient_code")
  name         String
  age          Int?
  gender       String?
  mobileNumber String   @map("mobile_number")
  address      String?  @db.Text
  city         String?
  createdAt    DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  registrations    Registration[]
  whatsappMessages WhatsappMessage[]

  // --- AP-1 relations (back-relations only; no column on this table) -------
  /// SetNull on the owning side, deliberately UNLIKE `registrations` above,
  /// which cascades. An appointment must survive as a record of what was booked
  /// even if the patient row it was later linked to is deleted — the
  /// denormalised name/mobileNumber on the appointment keep it readable.
  appointments Appointment[]

  /// Tenant-scoped, so two tenants can each independently hold PT-2026-0001.
  @@unique([tenantId, patientCode])
  @@index([clinicId])
  /// FR-3.2 — search by patient name or mobile number.
  @@index([name])
  @@index([mobileNumber])
  @@map("patients")
}

model Registration {
  id         String   @id @default(cuid())
  clinicId   String   @map("clinic_id")
  patientId  String   @map("patient_id")
  doctorId   String?  @map("doctor_id")
  /// FR-3.1 — required on the registration form.
  department String
  amount     Decimal  @db.Decimal(10, 2)
  /// Date AND time of the visit. A patient returning for a follow-up needs the
  /// appointment time recorded, not just the day, so this carries a clock time
  /// rather than being pinned to midnight like the DATE columns above.
  /// Stored as the clinic's wall-clock time tagged UTC — see src/lib/dates.ts.
  visitDate  DateTime @map("visit_date")
  /// "NEW" for a patient's first visit here, "FOLLOW_UP" for a return. Derived
  /// on create (an existing patient means a follow-up) but overridable by the
  /// front desk, since a return patient presenting a new complaint is a new
  /// case. Values live in src/lib/registrations.ts; a String rather than an
  /// enum so a clinic-specific visit type can be added without a migration.
  visitType  String   @default("NEW") @map("visit_type") @db.VarChar(20)
  createdBy  String   @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // --- AP-1: the appointment this visit came from, if any -----------------
  /// NULL on every registration created before appointments existed, and NULL
  /// on every walk-in afterwards. AP-5 sets it when it converts an appointment;
  /// AP-1 never populates it and does not change how registrations are created.
  ///
  /// This is the ONLY link between the two tables. There is deliberately no
  /// matching `convertedRegistrationId` on Appointment: two columns describing
  /// one fact would form a circular foreign key and could drift apart with
  /// nothing able to detect it. Ask the question from the other side instead —
  /// `appointment.registration` — which Prisma answers through this same column.
  appointmentId String? @map("appointment_id")

  clinic      Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient     Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  /// Restrict, not Cascade: a doctor leaving must not silently delete the
  /// revenue history attributed to them (FR-6.4 breaks revenue down by doctor).
  /// Nullable so a doctor can be detached from past visits instead.
  doctor      Doctor?      @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  creator     User         @relation("RegistrationCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  /// Restrict: an appointment that produced revenue must not be deletable, and
  /// nothing deletes appointments anyway — they retire by status.
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Restrict)

  editLog RegistrationEditLog[]

  /// One registration per appointment. This is the database-level guard against
  /// converting the same appointment twice: AP-5's second attempt hits this
  /// index rather than racing past an application check. Unlimited rows may
  /// hold NULL, which is what every pre-AP-1 registration holds.
  @@unique([appointmentId])
  @@index([clinicId])
  @@index([patientId])
  @@index([doctorId])
  /// FR-6.1 — revenue is aggregated by visit date over daily/weekly/monthly/yearly windows.
  @@index([visitDate])
  @@index([department])
  @@map("registrations")
}

/// FR-3.6 — immutable audit trail. APPEND-ONLY: never updated, never deleted,
/// not even by an Owner (PRD §9 Audit integrity). Readable only by Owner/Admin
/// roles, enforced in the API response and not merely by hiding the UI tab.
model RegistrationEditLog {
  id             String   @id @default(cuid())
  registrationId String   @map("registration_id")
  editedByUserId String   @map("edited_by_user_id")
  /// The editor's role name captured at edit time. Denormalised on purpose —
  /// if the user's role is changed or revoked later, the log must still show
  /// what they held when they made the edit.
  roleAtTime     String   @map("role_at_time")
  /// Per-field before/after values, e.g.
  /// {"amount":{"from":"500.00","to":"750.00"}}
  changedFields  Json     @map("changed_fields")
  timestamp      DateTime @default(now())

  /// Cascade only because a deleted registration's log has nothing left to
  /// describe. Nothing in the app deletes registrations today.
  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  editedBy     User         @relation(fields: [editedByUserId], references: [id], onDelete: Restrict)

  @@index([registrationId])
  @@index([editedByUserId])
  @@map("registration_edit_log")
}

// ---------------------------------------------------------------------------
// Notifications — PRD §7 `notifications`, FR-7.x
// ---------------------------------------------------------------------------

model Notification {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  /// Null = a tenant-wide notification not tied to any single clinic.
  clinicId        String?  @map("clinic_id")
  /// e.g. "registration.updated", "doctor.created".
  type            String
  message         String   @db.Text
  /// Id of the record the notification refers to. Intentionally not a foreign
  /// key: it points at whichever table `type` names.
  relatedRecordId String?  @map("related_record_id")
  read            Boolean  @default(false)
  createdAt       DateTime @default(now()) @map("created_at")

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clinic Clinic? @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  /// FR-7.2 — the notifications list queries unread first, scoped to a tenant.
  @@index([tenantId, read])
  @@index([clinicId])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// WhatsApp — PRD §7 `whatsapp_messages`, FR-9.x
//
// Provider: RkvRobo (https://bot.rkvrobo.in/api) — a gateway driving real
// WhatsApp devices, NOT an official BSP. There is no provider-side template
// approval, so the "sendable set" is defined here instead: every send names a
// WhatsappTemplate row, and no endpoint accepts a free-text body.
// ---------------------------------------------------------------------------

/// One separately purchased RkvRobo account. A tenant normally has one today,
/// but the relation is deliberately one-to-many for enterprise expansion.
model WhatsappProviderAccount {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  name            String
  apiBaseUrl      String   @default("https://bot.rkvrobo.in/api") @map("api_base_url")
  encryptedApiKey String   @map("encrypted_api_key") @db.Text
  keyVersion      Int      @default(1) @map("key_version")
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  devices WhatsappDevice[]

  @@unique([id, tenantId])
  @@unique([tenantId, name])
  @@index([tenantId, enabled])
  @@map("whatsapp_provider_accounts")
}

/// A deterministic RkvRobo sending device. `phoneNumber` is the provider's
/// sender identifier; "rotate" is rejected in the application layer.
model WhatsappDevice {
  id                String   @id @default(cuid())
  tenantId          String   @map("tenant_id")
  providerAccountId String   @map("provider_account_id")
  name              String
  phoneNumber       String   @map("phone_number")
  enabled           Boolean  @default(true)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  tenant          Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  providerAccount WhatsappProviderAccount  @relation(fields: [providerAccountId, tenantId], references: [id, tenantId], onDelete: Cascade)
  tenantDefaults  TenantWhatsappSettings[] @relation("TenantWhatsappDefaultDevice")
  clinicOverrides ClinicWhatsappSettings[] @relation("ClinicWhatsappDevice")
  messages        WhatsappMessage[]

  @@unique([id, tenantId])
  @@unique([providerAccountId, phoneNumber])
  @@index([tenantId, enabled])
  @@map("whatsapp_devices")
}

/// Organisation-wide fallback used when a clinic has no explicit override.
model TenantWhatsappSettings {
  id              String   @id @default(cuid())
  tenantId        String   @unique @map("tenant_id")
  defaultDeviceId String?  @map("default_device_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  defaultDevice WhatsappDevice? @relation("TenantWhatsappDefaultDevice", fields: [defaultDeviceId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@index([defaultDeviceId, tenantId])
  @@map("tenant_whatsapp_settings")
}

/// Optional per-clinic device choice. Absence means the tenant default applies.
model ClinicWhatsappSettings {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  clinicId  String   @unique @map("clinic_id")
  deviceId  String   @map("device_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clinic Clinic         @relation(fields: [clinicId, tenantId], references: [id, tenantId], onDelete: Cascade)
  device WhatsappDevice @relation("ClinicWhatsappDevice", fields: [deviceId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([clinicId, tenantId])
  @@index([tenantId])
  @@index([deviceId, tenantId])
  @@map("clinic_whatsapp_settings")
}

/// FR-9.1 — the account's approved message set.
///
/// Account-scoped, not clinic-scoped: one business writes its wording once and
/// every clinic under it sends the same approved text. `body` carries
/// {placeholder} tokens filled from the patient and registration at send time.
model WhatsappTemplate {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  /// Stored verbatim into `whatsapp_messages.template_name` on every send, so
  /// history stays readable even after a template is renamed or deleted.
  name      String
  body      String   @db.Text
  /// Optional footer line, passed through to the gateway.
  footer    String?
  /// Set together to send as media rather than text: `media_type` is one of
  /// image, video, audio, document and `media_url` must be a direct link.
  mediaType String?  @map("media_type")
  mediaUrl  String?  @map("media_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant      Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clinicMedia WhatsappTemplateMedia[]

  /// Template names are unique within an account, not globally.
  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("whatsapp_templates")
}

model WhatsappMessage {
  id                String   @id @default(cuid())
  clinicId          String   @map("clinic_id")
  patientId         String   @map("patient_id")
  mediaAssetId      String?  @map("media_asset_id")
  whatsappDeviceId  String?  @map("whatsapp_device_id")
  /// FR-9.1 — the WhatsappTemplate name this send used. Denormalised rather
  /// than a foreign key: history must survive the template being renamed or
  /// deleted, the same reasoning as `registration_edit_log.role_at_time`.
  templateName      String   @map("template_name")
  /// FR-9.2 — status as reported by the gateway. Free text rather than an enum
  /// because the provider defines its own states.
  ///
  /// RkvRobo answers a send with {status, msg} and nothing afterwards — it has
  /// no delivery-status callback — so in practice this holds `sent` (the
  /// gateway accepted it) or `failed`. It is NOT a WhatsApp delivered/read
  /// receipt, and the UI says so rather than implying one.
  status            String
  /// The WhatsApp message id, read from the gateway's `full=1` response at
  /// `data.key.id`. Unique so a future delivery-status callback can be made
  /// idempotent (see the secure-webhooks skill) — the same event can arrive
  /// more than once.
  providerMessageId String?  @unique @map("provider_message_id")
  /// The gateway's `msg` when a send failed — "device not connected", an
  /// invalid number, quota exhausted. Without it the front desk sees a red row
  /// and has no idea what to do next.
  failureReason     String?  @map("failure_reason") @db.Text
  sentAt            DateTime @default(now()) @map("sent_at")

  clinic         Clinic          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient        Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  mediaAsset     MediaAsset?     @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  whatsappDevice WhatsappDevice? @relation(fields: [whatsappDeviceId], references: [id], onDelete: SetNull)

  @@index([clinicId])
  @@index([patientId])
  @@index([clinicId, sentAt])
  @@index([mediaAssetId])
  @@index([whatsappDeviceId])
  @@map("whatsapp_messages")
}

enum StoredMediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

model MediaAsset {
  id               String          @id @default(cuid())
  tenantId         String          @map("tenant_id")
  clinicId         String          @map("clinic_id")
  uploadedByUserId String          @map("uploaded_by_user_id")
  originalFileName String          @map("original_file_name")
  storedFileName   String          @map("stored_file_name")
  mimeType         String          @map("mime_type")
  mediaType        StoredMediaType @map("media_type")
  fileSize         Int             @map("file_size")
  storagePath      String          @map("storage_path")
  sha256           String?         @map("sha256")
  lastUsedAt       DateTime?       @map("last_used_at")
  deletedAt        DateTime?       @map("deleted_at")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  tenant           Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clinic           Clinic                  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  uploadedBy       User                    @relation("MediaAssetUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: Cascade)
  templateMedia    WhatsappTemplateMedia[]
  whatsappMessages WhatsappMessage[]

  @@index([tenantId, clinicId])
  @@index([createdAt])
  @@index([mediaType])
  @@map("media_assets")
}

model WhatsappTemplateMedia {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  clinicId     String   @map("clinic_id")
  templateId   String   @map("template_id")
  mediaAssetId String   @map("media_asset_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clinic     Clinic           @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  template   WhatsappTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset       @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@unique([templateId, clinicId])
  @@index([tenantId, clinicId])
  @@index([mediaAssetId])
  @@index([templateId])
  @@map("whatsapp_template_media")
}

// ===========================================================================
// STAGE 1 — platform ownership, sessions, invitations, entitlements, audit
//
// Everything below this line is added by Stage 1 and is NOT wired into any
// runtime code path yet: the schema foundation lands first, the enforcement
// follows in Stages 2-8. Nothing here changes how an existing request is
// authorised today.
//
// Vocabulary, fixed for all new code:
//   Tenant   = the customer / clinic organisation (the thing that registers,
//              is approved, holds a plan, and is entitled to features)
//   Clinic   = an operational site beneath a Tenant
//   UserRole = the existing user-to-tenant role, optionally narrowed to one
//              Clinic. This IS the membership mechanism; there is deliberately
//              no separate Membership table.
//
// CURRENT-SCHEMA LIMITATION, recorded here so it is discoverable at the point
// of change: `users.tenant_id` is non-null, so one User belongs to exactly one
// Tenant. Supporting a person who works for several organisations would need a
// separate Membership table and a rewrite of every `actor.tenantId` call site.
// That is explicitly NOT designed for here.
// ===========================================================================

// ---------------------------------------------------------------------------
// Closed lifecycle and security states.
//
// These are native enums, departing from the String convention used for
// `visit_type`, `gender` and `whatsapp_messages.status` above. That convention
// exists because those are OPEN sets a clinic may extend without a migration.
// These are CLOSED sets guarding access: an unrecognised value must never be
// interpretable as "active" or "authorised", so the database rejects it.
//
// MIGRATION COST of adding a value later: each addition is an
// `ALTER TABLE ... MODIFY COLUMN ENUM(...)` on every table using the enum,
// which rewrites the column definition and takes a metadata lock. Cheap at this
// scale. REMOVING or renaming a value is breaking and needs a data backfill
// first. Accept that cost only for states that genuinely gate access.
// ---------------------------------------------------------------------------

/// Platform staff. Absent (NULL) on every ordinary customer user.
enum PlatformRole {
  SUPER_ADMIN
  /// Reserved for Stage 13. Nothing grants it yet.
  SUPPORT_ADMIN
}

/// Owner-controlled lifecycle of a customer organisation.
enum TenantStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
  ARCHIVED
}

/// Owner-controlled lifecycle of an individual login.
enum UserAccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  ARCHIVED
}

/// Tenant-Admin-controlled lifecycle of a person's access to their tenant.
enum MembershipStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
  REMOVED
}

enum InvitationStatus {
  CREATED
  OPENED
  EXPIRED
  REVOKED
  ACCEPTED
}

enum FeatureTier {
  CORE
  PREMIUM
  BETA
  INTERNAL
}

// ---------------------------------------------------------------------------
// Sessions — Stage 2/4.
//
// NOT an Auth.js database session. Auth.js only supports the JWT strategy with
// the Credentials provider, so this is our own registry alongside it: login
// mints a row here and puts its id in the JWT as `sid`. requireActor() then
// re-checks the row on every request, which is what makes revocation, "sign out
// all devices", and immediate lockout on suspension possible at all — a signed
// JWT on its own is valid until it expires and cannot be withdrawn.
//
// Authorisation claims are never read from the JWT. The JWT carries an opaque
// pointer; the database is the authority.
// ---------------------------------------------------------------------------
model AppSession {
  /// The value carried as the `sid` JWT claim. A missing or unknown sid must be
  /// treated as unauthenticated, never as "skip the check".
  id String @id @default(cuid())

  userId   String @map("user_id")
  /// Denormalised from the user so an Owner can revoke a whole organisation's
  /// sessions in one statement without a join.
  tenantId String @map("tenant_id")

  /// Only lengthens the session's own expiry. It NEVER means "remember the
  /// six-digit code" — codes are single-use and short-lived regardless.
  rememberMe Boolean @default(false) @map("remember_me")

  createdAt  DateTime @default(now()) @map("created_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  expiresAt  DateTime @map("expires_at")

  revokedAt    DateTime? @map("revoked_at")
  revokedById  String?   @map("revoked_by_id")
  revokeReason String?   @map("revoke_reason") @db.Text

  /// IPv6 fits in 45 characters.
  ip        String? @db.VarChar(45)
  userAgent String? @map("user_agent") @db.Text

  user      User   @relation("SessionUser", fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  revokedBy User?  @relation("SessionRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([tenantId])
  @@index([expiresAt])
  /// The hot path: "is this sid still live for this user?"
  @@index([userId, revokedAt])
  @@index([revokedById])
  @@map("app_sessions")
}

// ---------------------------------------------------------------------------
// Six-digit login codes — Stage 4.
//
// Generated by our own backend with node:crypto, never by an external OTP
// vendor. The plaintext code is mailed and then discarded: it is never stored,
// never logged, and never placed in a URL.
// ---------------------------------------------------------------------------
model LoginCode {
  id     String @id @default(cuid())
  userId String @map("user_id")

  /// Hash of the six-digit code. Sized at 255 so Stage 4 can choose between a
  /// bcrypt hash (60 chars) and an HMAC-SHA256 digest (64 chars).
  ///
  /// A six-digit code carries only ~20 bits of entropy, so a plain unsalted
  /// SHA-256 of it is reversible from a database dump by brute force in
  /// milliseconds. Stage 4 must therefore use either bcrypt or HMAC-SHA256
  /// keyed with a server-side pepper that does NOT live in this database.
  codeHash String @map("code_hash") @db.VarChar(255)

  expiresAt    DateTime  @map("expires_at")
  /// Set the moment the code is redeemed. Single use: a consumed row can never
  /// satisfy another verification.
  consumedAt   DateTime? @map("consumed_at")
  /// Incremented on every failed verification; the code dies past the limit.
  attemptCount Int       @default(0) @map("attempt_count")

  requestIp String?  @map("request_ip") @db.VarChar(45)
  userAgent String?  @map("user_agent") @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// "The newest unconsumed code for this user" — the lookup every verify does.
  @@index([userId, consumedAt])
  /// Sweeping expired rows.
  @@index([expiresAt])
  @@map("login_codes")
}

// ---------------------------------------------------------------------------
// Invitations — Stage 5.
//
// Created by a Tenant Admin for their OWN tenant. Owner approval is deliberately
// not part of this flow: routine staff onboarding belongs to the tenant.
// ---------------------------------------------------------------------------
model Invitation {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")

  /// Optional narrowing to one operational site, mirroring UserRole.clinicId
  /// exactly: NULL invites the person tenant-wide, a value invites them to that
  /// clinic. On acceptance this becomes the new UserRole.clinicId.
  ///
  /// It narrows scope; it never SUPPLIES authority. Tenant authorisation is
  /// resolved from tenantId, and acceptance is authorised by tokenHash alone.
  clinicId String? @map("clinic_id")

  /// Optional target address. When set, only that address may accept.
  email  String?
  /// The role proposed by the inviter. The Tenant Admin can still change it at
  /// approval time (Stage 6), so this is a proposal, not a grant.
  roleId String  @map("role_id")

  /// SHA-256 of a cryptographically random token. The raw token exists only in
  /// the invitation email; a database leak yields no usable invitation link.
  /// THIS is the only thing that authorises acceptance — never the tenant slug
  /// in the URL, which is cosmetic.
  tokenHash String @map("token_hash") @db.VarChar(64)

  status    InvitationStatus @default(CREATED)
  expiresAt DateTime         @map("expires_at")

  invitedById String?  @map("invited_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  openedAt         DateTime? @map("opened_at")
  acceptedAt       DateTime? @map("accepted_at")
  /// The user created (or matched) by accepting. This is the ONE authoritative
  /// direction of the user-invitation link: there is deliberately no
  /// `User.acceptedInvitationId`, because two foreign keys between the same
  /// pair of tables can disagree with each other.
  acceptedByUserId String?   @map("accepted_by_user_id")
  revokedAt        DateTime? @map("revoked_at")
  revokedById      String?   @map("revoked_by_id")

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clinic Clinic? @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  /// Restrict: deleting a role must not leave a pending invitation pointing at
  /// nothing, which would either fail or silently grant the wrong access.
  role   Role    @relation(fields: [roleId], references: [id], onDelete: Restrict)

  invitedBy      User? @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  revokedBy      User? @relation("InvitationRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)
  acceptedByUser User? @relation("InvitationAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  /// Unique so a token resolves to exactly one invitation, and so a replayed
  /// token cannot match a second row.
  @@unique([tokenHash])
  @@index([tenantId, status])
  @@index([email])
  @@index([roleId])
  @@index([clinicId])
  @@index([acceptedByUserId])
  @@index([invitedById])
  @@index([revokedById])
  @@index([expiresAt])
  @@map("invitations")
}

// ---------------------------------------------------------------------------
// Feature entitlements — Stage 8.
//
// Four layers, resolved in this order (src/lib/featureResolution.ts):
//
//   1. Feature.globalEnabled       — Owner kill switch, platform-wide
//   2. PlanFeature                 — the tenant's plan baseline
//      + TenantFeatureOverride     — an explicit per-tenant grant or revoke,
//                                    which OVERRIDES the plan in both directions
//   3. RoleFeatureAccess           — the Tenant Admin's per-role choice
//   4. the action permission        — lib/rbac.ts, unchanged
//
// Layers 1 and 2 belong to the Owner; layer 3 belongs to the Tenant Admin. A
// Tenant Admin therefore cannot reach past a global kill switch or grant a
// feature the tenant is not entitled to: layer 3 is an AND, never a fallback.
//
// Role ACTION permissions (lib/permissions.ts) and feature ENTITLEMENTS are
// deliberately separate systems. A permission says what an action is; an
// entitlement says whether the organisation bought the module it lives in.
// ---------------------------------------------------------------------------

model Plan {
  id          String   @id @default(cuid())
  /// Stable machine key, e.g. "standard". Referenced by seeds and code.
  key         String
  name        String
  description String?  @db.Text
  /// Retire a plan by clearing this rather than deleting the row — tenants
  /// point at it, and the foreign key is Restrict for exactly that reason.
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenants  Tenant[]
  features PlanFeature[]

  @@unique([key])
  @@map("plans")
}

model Feature {
  id          String      @id @default(cuid())
  /// Stable machine key, e.g. "registrations". Code checks this, never `name`.
  key         String
  name        String
  description String?     @db.Text
  tier        FeatureTier @default(CORE)

  /// Layer 1 — the Owner's platform-wide kill switch. False disables the
  /// feature for EVERY tenant regardless of plan or override. No Tenant Admin
  /// can reach past it.
  globalEnabled      Boolean   @default(true) @map("global_enabled")
  /// Who last flipped the switch and why. Stage 9 requires a reason for a
  /// manual change in BOTH directions (see evaluateGlobalSwitch) and stamps all
  /// three columns in the same transaction as the flip. This is the LAST change
  /// only — the full history lives in AuditLog, under FEATURE_GLOBAL_ENABLED /
  /// FEATURE_GLOBAL_DISABLED, and is never updated or deleted.
  globalChangedById  String?   @map("global_changed_by_id")
  globalChangedAt    DateTime? @map("global_changed_at")
  globalChangeReason String?   @map("global_change_reason") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  globalChangedBy User? @relation("FeatureGlobalChangedBy", fields: [globalChangedById], references: [id], onDelete: SetNull)

  plans           PlanFeature[]
  tenantOverrides TenantFeatureOverride[]
  roleAccess      RoleFeatureAccess[]

  @@unique([key])
  @@index([tier])
  @@index([globalEnabled])
  @@index([globalChangedById])
  @@map("features")
}

/// Layer 2a — what a plan includes by default.
model PlanFeature {
  id        String   @id @default(cuid())
  planId    String   @map("plan_id")
  featureId String   @map("feature_id")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  plan    Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([planId, featureId])
  @@index([featureId])
  @@map("plan_features")
}

/// Layer 2b — an Owner's explicit decision for ONE tenant, which overrides the
/// plan in both directions: it can grant a feature the plan omits, and revoke
/// one the plan includes.
model TenantFeatureOverride {
  id        String  @id @default(cuid())
  tenantId  String  @map("tenant_id")
  featureId String  @map("feature_id")
  enabled   Boolean

  /// Required, not optional: a manual override that contradicts the plan must
  /// carry an explanation, or nobody can tell later whether it was deliberate.
  reason      String   @db.Text
  changedById String?  @map("changed_by_id")
  changedAt   DateTime @default(now()) @map("changed_at")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  feature   Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)
  changedBy User?   @relation("TenantOverrideChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@unique([tenantId, featureId])
  @@index([featureId])
  @@index([changedById])
  @@map("tenant_feature_overrides")
}

/// Layer 3 — the Tenant Admin's per-role choice, within what the tenant already
/// has. Writing a row here can only ever NARROW access: the tenant entitlement
/// is checked first and independently.
///
/// DEFAULT WHEN NO ROW EXISTS: the role inherits the tenant entitlement.
/// Absence means "the Tenant Admin has expressed no opinion", not "denied".
/// Deny-by-default would require a row for every (role x feature) pair and
/// would silently lock out every role the moment a new feature is added.
model RoleFeatureAccess {
  id        String   @id @default(cuid())
  roleId    String   @map("role_id")
  featureId String   @map("feature_id")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  role    Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  feature Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([roleId, featureId])
  @@index([featureId])
  @@map("role_feature_access")
}

// ---------------------------------------------------------------------------
// Application audit log — Stage 11.
//
// APPEND-ONLY, the same contract as registration_edit_log: never updated,
// never deleted, not even by an Owner.
//
// Stage 1 establishes the table only; nothing writes to it yet.
//
// NEVER put in `beforeValue`, `afterValue` or `reason`:
//   plaintext login codes, invitation tokens, password hashes, patient records,
//   or any clinical detail. This table is read by platform staff across every
//   tenant, so it must carry decisions, not data.
// ---------------------------------------------------------------------------
model AuditLog {
  id String @id @default(cuid())

  /// Null for an action taken by the system rather than a person.
  actorUserId       String?       @map("actor_user_id")
  /// Captured at the time of the action and denormalised on purpose: if the
  /// actor's platform role changes later, the log must still show what they
  /// held when they acted. Same reasoning as registration_edit_log.role_at_time.
  actorPlatformRole PlatformRole? @map("actor_platform_role")
  /// The tenant the actor was acting within, or null for a platform-wide action.
  actorTenantId     String?       @map("actor_tenant_id")

  /// e.g. "CLINIC_APPROVED", "LOGIN_FAILED", "ROLE_CHANGED".
  action     String  @db.VarChar(64)
  /// e.g. "Tenant", "User", "Invitation".
  targetType String  @map("target_type") @db.VarChar(64)
  /// Not a foreign key: it points at whichever table `targetType` names.
  targetId   String? @map("target_id")

  beforeValue Json?   @map("before_value")
  afterValue  Json?   @map("after_value")
  reason      String? @db.Text

  ip        String? @db.VarChar(45)
  userAgent String? @map("user_agent") @db.Text
  requestId String? @map("request_id") @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at")

  /// Restrict on both, matching registration_edit_log.edited_by. An audit trail
  /// that a delete can erase is not an audit trail. The consequence is
  /// deliberate: tenants and users are ARCHIVED, never hard-deleted.
  actor       User?   @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  actorTenant Tenant? @relation(fields: [actorTenantId], references: [id], onDelete: Restrict)

  @@index([actorTenantId, createdAt])
  @@index([targetType, targetId])
  @@index([action, createdAt])
  @@index([actorUserId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Tasks — permission-driven work assignment within tenant and clinic scope.
// ---------------------------------------------------------------------------

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Task {
  id       String  @id @default(cuid())
  tenantId String  @map("tenant_id")
  clinicId String? @map("clinic_id")

  title       String       @db.VarChar(160)
  description String?      @db.Text
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(OPEN)
  dueAt       DateTime?    @map("due_at")

  createdById  String  @map("created_by_id")
  assignedToId String? @map("assigned_to_id")

  completedAt   DateTime? @map("completed_at")
  completedById String?   @map("completed_by_id")
  archivedAt    DateTime? @map("archived_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clinic Clinic? @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  createdBy   User  @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  assignedTo  User? @relation("TaskAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  completedBy User? @relation("TaskCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([clinicId])
  @@index([assignedToId])
  @@index([createdById])
  @@index([status])
  @@index([dueAt])
  @@index([tenantId, status])
  @@index([clinicId, status])
  @@map("tasks")
}

// ---------------------------------------------------------------------------
// Rate limiting — Stage 4/12 foundation.
//
// Durable and database-backed rather than in-process, so a restart cannot reset
// an attacker's counter. No Redis: PRD section 11 rules out stacking another
// paid vendor, and this is one indexed row per subject.
//
// KNOWN CEILING: a single MySQL table serialises writes on the hottest keys and
// will become a bottleneck under real load or across multiple app instances.
// The interface Stage 4 builds on top must stay swappable so it can be moved to
// Redis or an in-memory tier later without touching the call sites.
//
// Stage 1 establishes the table only; nothing reads or writes it yet.
// ---------------------------------------------------------------------------
model RateLimitBucket {
  id String @id @default(cuid())

  /// The throttled subject, namespaced by dimension so one table serves all of
  /// them, e.g. "login-code:request:email:a@b.com", "login-code:verify:ip:1.2.3.4",
  /// "invite:create:tenant:<id>". Stage 4 owns the key format.
  key String

  windowStartedAt DateTime  @map("window_started_at")
  count           Int       @default(0)
  /// Set when a subject trips the limit; requests are refused until it passes.
  blockedUntil    DateTime? @map("blocked_until")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Unique so an increment can be a single atomic upsert rather than a
  /// read-then-write race between two concurrent login attempts.
  @@unique([key])
  @@index([blockedUntil])
  @@index([windowStartedAt])
  @@map("rate_limit_buckets")
}

// ---------------------------------------------------------------------------
// Appointments — AP-1.
//
// SCHEMA ONLY. Nothing reads or writes these tables yet: AP-2 computes slots,
// AP-3 books, AP-4 reschedules/cancels/checks in, AP-5 converts. The tables and
// the permission catalogue land first so the migration is a one-time event
// rather than something each later stage has to re-run over live data.
//
// Three rules govern everything below, and every later stage inherits them:
//
//   1. NO APPOINTMENT ROW IS EVER DELETED. Cancel, no-show, reschedule and
//      conversion are all STATUS TRANSITIONS. The audit trail and any future
//      utilisation reporting depend on the retired rows still being there.
//
//   2. slot_start / slot_end ARE NEVER UPDATED after insert. Rescheduling
//      creates a NEW row pointing back at the old one; it does not move the old
//      one. That is what keeps the history honest and what makes
//      `active_slot_start` a pure function of `status`.
//
//   3. OCCUPANCY IS DERIVED FROM STATUS, IN EXACTLY ONE COLUMN.
//        active_slot_start = slot_start  when status is
//                            SCHEDULED | CONFIRMED | CHECKED_IN | CONVERTED
//        active_slot_start IS NULL       when status is
//                            CANCELLED | NO_SHOW | RESCHEDULED
//      src/lib/appointmentRules.ts is the single source of that mapping and
//      scripts/verify-ap1-appointments-schema.mts asserts it over real rows.
// ---------------------------------------------------------------------------

/// The appointment lifecycle.
///
/// A native enum, not the String-with-constants treatment `visit_type` gets.
/// The difference is that `visit_type` is deliberately open — a clinic may want
/// its own — whereas this set is closed: every value here changes whether the
/// doctor's time is occupied, so an unrecognised one would be a correctness bug
/// rather than a harmless label.
///
/// CONVERTED OCCUPIES THE SLOT. A converted appointment is a patient who
/// arrived and was seen, so the time was genuinely consumed. Releasing it would
/// let a second booking land where a visit demonstrably happened.
enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CHECKED_IN
  CONVERTED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

enum AppointmentBookingSource {
  STAFF
  PHONE_IVR
}

/// A bookable service: its name, how long it takes, and what it costs.
model AppointmentType {
  id       String  @id @default(cuid())
  tenantId String  @map("tenant_id")
  /// NULL = offered at every clinic under this tenant; set = that site only.
  /// This is the same nullable-clinic convention `user_roles.clinic_id` uses,
  /// reused rather than reinvented.
  ///
  /// MySQL treats NULLs as DISTINCT in a unique index, so the @@unique below
  /// does NOT stop two tenant-wide types sharing a name — exactly the quirk
  /// documented on UserRole. The duplicate check must be done in application
  /// code before insert, the way src/lib/roles.ts already does it. AP-6/AP-7
  /// owns that check; AP-1 only records the constraint and this warning.
  clinicId String? @map("clinic_id")

  name            String
  durationMinutes Int     @map("duration_minutes")
  /// Seeds Appointment.amount at booking time. The booked amount is copied onto
  /// the appointment rather than read through this relation, so re-pricing a
  /// type never rewrites money that was already quoted to a patient.
  ///
  /// NO DATABASE DEFAULT, deliberately: a type created without a price should
  /// fail loudly rather than silently become free.
  defaultAmount   Decimal @map("default_amount") @db.Decimal(10, 2)
  /// Retire a type by clearing this, never by deleting the row — appointments
  /// point at it and the foreign key is Restrict for exactly that reason. Same
  /// pattern as Plan.isActive.
  isActive        Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clinic Clinic? @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  appointments Appointment[]

  @@unique([tenantId, clinicId, name])
  @@index([tenantId])
  @@index([clinicId])
  /// The booking form's lookup: this tenant's live types.
  @@index([tenantId, isActive])
  @@map("appointment_types")
}

/// One booked slot in a doctor's day.
model Appointment {
  id       String @id @default(cuid())
  /// Denormalised from `clinic.tenant_id`, following the Patient precedent: it
  /// makes tenant filtering one indexed column rather than a join. Keep it in
  /// step with the owning clinic's tenant on every write.
  tenantId String @map("tenant_id")
  clinicId String @map("clinic_id")

  doctorId          String  @map("doctor_id")
  appointmentTypeId String  @map("appointment_type_id")
  /// NULL = someone who is not a patient here yet. Booking never mints a
  /// Patient row or a PT-YYYY-#### code; AP-5 conversion does, which keeps the
  /// code sequence free of people who only ever cancelled.
  patientId         String? @map("patient_id")

  // Patient details, named EXACTLY as on `patients` so the booking form can
  // reuse the registration form's fieldset and AP-5 can copy across without a
  // translation layer. Deliberately not `patientName` / `patientPhone`.
  name         String
  mobileNumber String  @map("mobile_number")
  age          Int?
  gender       String?
  address      String? @db.Text
  city         String?

  amount Decimal @db.Decimal(10, 2)

  /// Half-open [slotStart, slotEnd): two appointments touching end-to-start do
  /// NOT overlap. Same convention lib/doctors.ts already uses for availability.
  ///
  /// Wall-clock time tagged UTC, exactly like registrations.visit_date — see
  /// src/lib/dates.ts. No real timezone conversion happens anywhere.
  ///
  /// NEVER UPDATED AFTER INSERT — see rule 2 in the header above.
  slotStart DateTime @map("slot_start")
  slotEnd   DateTime @map("slot_end")

  /// Mirrors slot_start while this appointment occupies the doctor's time, and
  /// is NULL the moment it releases it.
  ///
  /// MySQL has no partial unique index, so this is how @@unique([doctor_id,
  /// active_slot_start]) is made to constrain only LIVE rows: MySQL treats
  /// NULLs as distinct, so any number of retired appointments may share a
  /// doctor and a start time while at most one live one can. The same
  /// NULL-distinct behaviour roles(tenant_id, key) already relies on.
  ///
  /// THIS INDEX IS A BACKSTOP, NOT THE CONCURRENCY CONTROL. It catches exact
  /// duplicate starts only; a 30-minute slot at 09:00 and a 15-minute one at
  /// 09:15 have different starts and would slip past it. DoctorScheduleLock
  /// plus the overlap query is the real guard — see that model.
  activeSlotStart DateTime? @map("active_slot_start")

  status AppointmentStatus @default(SCHEDULED)

  bookingSource    AppointmentBookingSource @default(STAFF) @map("booking_source")
  bookingSourceRef String?                  @map("booking_source_ref")
  bookedById       String?                  @map("booked_by_id")

  checkedInAt   DateTime? @map("checked_in_at")
  checkedInById String?   @map("checked_in_by_id")

  cancelledAt        DateTime? @map("cancelled_at")
  cancelledById      String?   @map("cancelled_by_id")
  cancellationReason String?   @map("cancellation_reason") @db.Text

  /// Set on the NEW row created by a reschedule, pointing back at the row it
  /// replaced. Walk it backwards with `rescheduledFrom` and forwards with
  /// `rescheduledTo`; an appointment moved N times is a linked list ending in
  /// the one live row.
  rescheduledFromId String? @map("rescheduled_from_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clinic          Clinic          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  /// Restrict, matching Registration.doctor: a doctor leaving must not silently
  /// delete the schedule history attributed to them.
  doctor          Doctor          @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  /// Restrict — retire a type with isActive, do not delete it.
  appointmentType AppointmentType @relation(fields: [appointmentTypeId], references: [id], onDelete: Restrict)
  /// SetNull, NOT Cascade. Deleting a patient must never delete an appointment
  /// (see rule 1). The denormalised name/mobileNumber above keep the orphaned
  /// row readable.
  patient         Patient?        @relation(fields: [patientId], references: [id], onDelete: SetNull)

  /// Restrict, matching Registration.creator — who booked it is part of the
  /// record.
  bookedBy    User? @relation("AppointmentBookedBy", fields: [bookedById], references: [id], onDelete: Restrict)
  /// SetNull — denormalised display pointers, like Tenant.approvedBy. AuditLog
  /// holds the authoritative, append-only trail of who did what.
  checkedInBy User? @relation("AppointmentCheckedInBy", fields: [checkedInById], references: [id], onDelete: SetNull)
  cancelledBy User? @relation("AppointmentCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)

  rescheduledFrom Appointment?  @relation("AppointmentReschedule", fields: [rescheduledFromId], references: [id], onDelete: Restrict)
  rescheduledTo   Appointment[] @relation("AppointmentReschedule")

  /// Written by AP-5. Back-relation only — the column lives on `registrations`,
  /// and its UNIQUE is what stops a second conversion. See Registration above.
  registration Registration?

  /// The backstop described on `activeSlotStart`. Not the primary guard.
  @@unique([doctorId, activeSlotStart])
  /// Database idempotency backstop for non-null system-channel references.
  /// MySQL permits every STAFF row's NULL reference while rejecting a second
  /// PHONE_IVR row carrying the same deterministic reference.
  @@unique([bookingSource, bookingSourceRef])
  /// The appointment list: this clinic's board, filtered by state.
  @@index([tenantId, clinicId, status])
  /// The overlap query in AP-3 and the day view in AP-6.
  @@index([doctorId, slotStart])
  @@index([clinicId, slotStart])
  @@index([patientId])
  @@index([appointmentTypeId])
  @@index([rescheduledFromId])
  @@index([bookedById])
  @@index([checkedInById])
  @@index([cancelledById])
  @@map("appointments")
}

/// One row per doctor per calendar day, existing solely to be locked — AP-1.
///
/// It carries no data and is never read for its contents. Its job is to give
/// every write that can occupy or release a doctor's time a single row to
/// serialise on, because the check-then-insert those writes perform is a race
/// otherwise. An application-level "is this slot free?" query is NOT
/// concurrency-safe on its own; two requests can both read "free" and both
/// insert. The lock is what closes that window.
///
/// PROTOCOL — every booking, reschedule, cancel and check-in path in AP-3/AP-4
/// must follow this, inside one transaction set to READ COMMITTED:
///
///   1. INSERT the (doctor_id, date) row ... ON DUPLICATE KEY UPDATE, so it
///      exists and is exclusively locked. NOT `INSERT IGNORE`, which takes a
///      SHARED lock and deadlocks when two bookings both try to upgrade it to
///      the exclusive lock step 2 needs. Verified by racing real transactions —
///      see prisma/migrations/APPOINTMENT_NOTES.md.
///   2. SELECT ... FOR UPDATE it. This is the serialisation point; a competing
///      transaction blocks here until the first commits or rolls back.
///   3. Run the overlap query AS A LOCKING READ:
///        existing.slot_start < requested.slot_end
///        AND existing.slot_end > requested.slot_start
///        AND status IN (SCHEDULED, CONFIRMED, CHECKED_IN, CONVERTED)
///      It MUST be FOR UPDATE, and the transaction MUST be READ COMMITTED.
///      Under REPEATABLE READ this read takes GAP LOCKS over the range it
///      scans even when it matches nothing, so two bookings for DIFFERENT
///      doctors at the same time of day deadlock each other. READ COMMITTED
///      takes no gap locks, and gives every statement the latest committed
///      data rather than a snapshot pinned at the transaction's first read.
///      Do every scope/validation read BEFORE the transaction opens anyway.
///   4. Only then insert or update.
///
/// LOCK ORDERING — acquire in ascending (doctorId, date). Booking touches one
/// doctor-day so it cannot deadlock; a reschedule may touch two (old and new,
/// possibly different doctors) and would deadlock against its mirror image
/// without a deterministic order.
///
/// An appointment cannot span two calendar dates (asserted in
/// appointmentRules.ts), which is what makes (doctorId, date) a complete key:
/// two conflicting appointments necessarily share a date and therefore this row.
///
/// Rows are created on demand and never cleaned up. One row per doctor per
/// booked day is negligible, and deleting them would reintroduce the race.
model DoctorScheduleLock {
  id       String   @id @default(cuid())
  doctorId String   @map("doctor_id")
  date     DateTime @db.Date

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  /// The lock key. Also what makes step 1's INSERT IGNORE safe under a race:
  /// the loser is rejected by this index rather than creating a second row that
  /// would split the lock in two.
  @@unique([doctorId, date])
  @@map("doctor_schedule_locks")
}

import { PrismaClient } from '@prisma/client'; const prisma = new PrismaClient(); async function main() { const user = await prisma.user.findUnique({where: {email: 'familiarkart@gmail.com'}}); await prisma.user.update({ where: { id: user.id }, data: { emailVerifiedAt: new Date(), accountStatus: 'ACTIVE', membershipStatus: 'ACTIVE' } }); await prisma.tenant.update({ where: { id: user.tenantId }, data: { status: 'ACTIVE' } }); console.log('Done'); } main().catch(e => console.error(e));

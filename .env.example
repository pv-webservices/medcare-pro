# ---------------------------------------------------------------------------
# MEDCARE PRO — environment template.
# Copy to `.env` and fill in. Never commit `.env`.
#
# This is a single shared deployment serving every tenant, so there is exactly
# one of each of these values — not one set per clinic.
# ---------------------------------------------------------------------------

# Database — the single shared Hostinger MySQL database (PRD §8).
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE_NAME"

# Auth.js — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
# Public URL of the deployment.
NEXTAUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Plivo Voice - deployment-level credentials for inbound webhook validation.
#
# Copy both values from the Plivo Console Overview page. Stage 1 uses the Auth
# Token to validate every Voice webhook with Plivo's V3 signature helper. The
# Auth ID is retained alongside it for official SDK configuration in later
# telephony stages; Stage 1 does not make authenticated Plivo API calls.
#
# These credentials identify the shared telephony provider account. A clinic's
# eventual phone-number configuration belongs in tenant-scoped data, not here.
# Do not add a permanent global PLIVO_PHONE_NUMBER setting.
# ---------------------------------------------------------------------------
PLIVO_AUTH_ID=""
PLIVO_AUTH_TOKEN=""
# Trusted public origin used for Plivo V3 validation and generated callback
# URLs behind a reverse proxy. Origin only: no path, query, or fragment.
PLIVO_PUBLIC_WEBHOOK_ORIGIN=""

# ---------------------------------------------------------------------------
# Six-digit login codes — Stage 4 (src/lib/loginCode.ts).
#
# The HMAC-SHA256 key that login codes are hashed with before storage. It lives
# HERE and never in the database, which is the entire point: a six-digit code
# carries only ~20 bits of entropy, so a stolen `login_codes` table would be
# reversed by exhaustive search in milliseconds against any unkeyed hash. With a
# pepper the attacker cannot compute a candidate digest at all.
#
# Generate with: openssl rand -base64 48
#
#   - REQUIRED in production. A deployment without it refuses to issue or verify
#     any login code rather than falling back to something predictable.
#   - Locally, NODE_ENV=development and NODE_ENV=test fall back to a documented
#     constant so tests run without setup. That fallback is an allowlist, so an
#     unset or misspelled NODE_ENV fails closed rather than silently accepting a
#     value that is public in the source tree.
#   - Rotating it invalidates every outstanding code. Users request a new one;
#     nothing else is affected, and no session is disturbed.
LOGIN_CODE_PEPPER=""

# ---------------------------------------------------------------------------
# Transactional email — required by FR-1.2 (signup verification links).
# Provider: Resend (implemented in src/lib/email.ts).
#
# EMAIL_API_KEY       Resend API key — starts with "re_".
# EMAIL_FROM_ADDRESS  Sender on a domain verified in Resend, e.g.
#                     "MEDCARE PRO <noreply@yourdomain.com>". Resend rejects
#                     sends from unverified domains.
#
# The verification link's origin is taken from NEXTAUTH_URL above, so no
# separate app-URL variable is needed.
# ---------------------------------------------------------------------------
EMAIL_API_KEY=""
EMAIL_FROM_ADDRESS=""

# ---------------------------------------------------------------------------
# WhatsApp — provider: RkvRobo (https://bot.rkvrobo.in).
#
# NOT the Meta Cloud API and NOT an official BSP: RkvRobo drives real WhatsApp
# devices through its own portal. There is no provider-side template approval,
# so the approved message set lives in this app (`whatsapp_templates`) and no
# endpoint here accepts a free-typed body.
#
# WHATSAPP_BSP_API_KEY       Profile Settings → API Key in the RkvRobo panel.
#                            Sending is disabled while this is blank, and the
#                            Messages page says so.
# WHATSAPP_BSP_API_BASE_URL  Optional override. Defaults to
#                            https://bot.rkvrobo.in/api
# WHATSAPP_BSP_SENDER        REQUIRED. The connected device's number, exactly as
#                            the Devices page shows it. There is no default:
#                            picking a device silently would send from a number
#                            the clinic did not choose.
#
#                            "rotate" is accepted and spreads sends across
#                            devices — but ONLY works when at least one device
#                            has Rotate switched ON in the panel. Devices arrive
#                            Rotate OFF, so do not set this until you have.
# ---------------------------------------------------------------------------
WHATSAPP_BSP_API_KEY=""
WHATSAPP_BSP_API_BASE_URL=""
WHATSAPP_BSP_SENDER=""

# ---------------------------------------------------------------------------
# WhatsApp delivery callbacks (FR-9.2).
#
# RkvRobo posts to a URL you paste per device on its Devices page, but it does
# NOT sign the request. The only verifiable secret is one we put in the URL
# ourselves, so generate a long random value here:
#
#     openssl rand -hex 32
#
# then register this in the panel's Webhook URL column:
#
#     https://<your-app>/api/whatsapp/webhook?token=<the value below>
#
# Left blank, the webhook route rejects every request (fails closed) — an
# unconfigured deployment must not accept anonymous posts.
# ---------------------------------------------------------------------------
WHATSAPP_WEBHOOK_TOKEN=""

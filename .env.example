# ---------------------------------------------------------------------------
# Clinic Management System — environment template.
# Copy to `.env` and fill in. Every value here is clinic-specific: this file is
# the only place a deployment differs from the template repo. Never commit `.env`.
# ---------------------------------------------------------------------------

# Database — this clinic's own dedicated Hostinger MySQL database (PRD §10).
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE_NAME"

# Auth.js — generate a fresh secret per clinic: `openssl rand -base64 32`
NEXTAUTH_SECRET=""

# WhatsApp Cloud API (Meta) — template messaging only (PRD §10 Compliance).
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""

# Twilio — after-hours IVR / DTMF capture.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
